# Copy to .env and `export $(grep -v '^#' .env | xargs)`, or set these in your shell.

# Folder holding the databases make_dbs.py builds (idx_10k.db, noidx_1m.db, ...).
# Default: datasets/store/generated/sqlite/ in this repo.
# DATA_DIR=

# How long (ms) a writer waits for the lock before "database is locked".
# 08_concurrency runs once with 0 and once with 5000.
BUSY_TIMEOUT_MS=5000
